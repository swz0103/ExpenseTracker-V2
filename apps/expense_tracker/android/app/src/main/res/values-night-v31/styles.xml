<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the process starts in the dark theme (Android 12 and later): the app's paper colour and nothing
         else, so the opening animation seems to be the first thing shown. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12 and later draw their own start screen: no icon on it. -->
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_background</item>
    </style>
    <!-- Behind the Flutter UI once it starts: the same paper colour, so no
         white or black flashes between the start and the first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
