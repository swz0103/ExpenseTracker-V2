<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the process starts: the app's paper colour and nothing
         else, so the opening animation seems to be the first thing shown. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI once it starts: the same paper colour, so no
         white or black flashes between the start and the first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
