<?xml version="1.0" encoding="utf-8"?>
<!-- 本月概況 made one row high, and the widget 記一筆 (QuickWidget.kt): what
     is left of the month's budget over its bar, and round − and ＋. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="9dp">

    <LinearLayout
        android:id="@+id/short_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/short_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="10 月預算剩"
            android:textColor="#7A858B"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/short_figure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="7,660"
            android:textColor="#26323A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/short_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:max="100"
            android:progress="62"
            android:progressDrawable="@drawable/widget_progress"
            android:secondaryProgress="94" />
    </LinearLayout>
    <TextView
        android:id="@+id/short_expense"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_button_expense"
        android:contentDescription="記支出"
        android:gravity="center"
        android:text="−"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/short_income"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_button_income"
        android:contentDescription="記收入"
        android:gravity="center"
        android:text="＋"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
