<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: 記支出 or 記收入 opens the composer at once. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="expense"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_expense">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.swz0103.expensetracker"
            android:targetClass="io.github.swz0103.expensetracker.MainActivity">
            <extra android:name="quick" android:value="expense" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="income"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_income">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.swz0103.expensetracker"
            android:targetClass="io.github.swz0103.expensetracker.MainActivity">
            <extra android:name="quick" android:value="income" />
        </intent>
    </shortcut>
</shortcuts>
