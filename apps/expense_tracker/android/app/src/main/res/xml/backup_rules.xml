<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier: the same as data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="file" path="."/>
    <exclude domain="file" path="device-id"/>
    <exclude domain="file" path="no-fingerprint"/>
    <exclude domain="file" path="exports"/>
</full-backup-content>
