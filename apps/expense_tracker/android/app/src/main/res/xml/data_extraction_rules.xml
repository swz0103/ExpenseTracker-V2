<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The ledger and its weekly backups go to the
     person's Google backup, which Android encrypts with the screen lock;
     what belongs to this phone alone (its fingerprint enrolment) stays. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="."/>
        <exclude domain="file" path="device-id"/>
        <exclude domain="file" path="no-fingerprint"/>
        <exclude domain="file" path="exports"/>
        <exclude domain="file" path="calendar"/>
        <exclude domain="file" path="diagnostics.log"/>
        <!-- The backup waiting for the background job (BackupWorker.kt). -->
        <exclude domain="file" path="outbox"/>
        <!-- Receipt photos would soon fill the 25 MB backup allowance. -->
        <exclude domain="file" path="receipts"/>
        <!-- The ledger kept before a restore, with its photos. -->
        <exclude domain="file" path="before-restore"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="."/>
        <exclude domain="file" path="device-id"/>
        <exclude domain="file" path="no-fingerprint"/>
        <exclude domain="file" path="exports"/>
        <exclude domain="file" path="calendar"/>
        <exclude domain="file" path="diagnostics.log"/>
        <!-- The backup waiting for the background job (BackupWorker.kt). -->
        <exclude domain="file" path="outbox"/>
    </device-transfer>
</data-extraction-rules>
