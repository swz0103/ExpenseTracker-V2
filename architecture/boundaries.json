{
  "version": 1,
  "sdkLibraries": [
    "dart:async",
    "dart:collection",
    "dart:convert",
    "dart:core",
    "dart:math",
    "dart:typed_data"
  ],
  "modules": {
    "core": {
      "directory": "packages/core",
      "publicEntrypoints": [
        "foundation_values.dart",
        "app_core.dart"
      ],
      "testEntrypoints": [
        "testing.dart"
      ],
      "dependencies": []
    },
    "domain": {
      "directory": "packages/domain",
      "publicEntrypoints": [
        "accounts.dart",
        "bookkeeping.dart",
        "budgets.dart",
        "categories.dart",
        "credit_cards.dart",
        "data_exchange.dart",
        "investments.dart",
        "ledger.dart",
        "memory.dart",
        "merchants.dart",
        "recurring_transactions.dart",
        "reports.dart",
        "tags.dart"
      ],
      "dependencies": [
        "core"
      ]
    }
  },
  "runtimeModules": {
    "market": {
      "directory": "infrastructure/market",
      "publicEntrypoints": [
        "market_data.dart",
        "market_adapters.dart"
      ],
      "dependencies": [
        "core",
        "domain"
      ]
    },
    "storage": {
      "directory": "infrastructure/storage",
      "publicEntrypoints": [
        "storage_sqlcipher.dart",
        "ledger_sqlcipher.dart"
      ],
      "testEntrypoints": [
        "testing.dart"
      ],
      "dependencies": [
        "core",
        "domain"
      ]
    },
    "vault": {
      "directory": "infrastructure/vault",
      "publicEntrypoints": [
        "backup_security.dart",
        "ledger_vault.dart",
        "ledger_backup.dart",
        "backup_service.dart",
        "drive_backup.dart"
      ],
      "testEntrypoints": [
        "testing.dart"
      ],
      "dependencies": [
        "core",
        "storage"
      ]
    },
    "expense_tracker": {
      "directory": "apps/expense_tracker",
      "dependencies": [
        "core",
        "domain",
        "market",
        "storage",
        "vault"
      ]
    }
  }
}
