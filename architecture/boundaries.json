{
  "version": 1,
  "sdkLibraries": [
    "dart:async",
    "dart:collection",
    "dart:convert",
    "dart:core",
    "dart:math",
    "dart:typed_data"
  ],
  "modules": {
    "foundation_values": {
      "directory": "packages/foundation_values",
      "publicEntrypoints": [
        "foundation_values.dart"
      ],
      "dependencies": [
        "uuid"
      ]
    },
    "bookkeeping": {
      "directory": "packages/bookkeeping",
      "publicEntrypoints": ["bookkeeping.dart", "memory.dart"],
      "dependencies": ["accounts", "app_core", "budgets", "categories", "credit_cards", "foundation_values", "investments", "ledger", "merchants", "recurring_transactions", "reports", "tags"]
    },
    "app_core": {
      "directory": "packages/app_core",
      "publicEntrypoints": [
        "app_core.dart",
        "testing.dart"
      ],
      "dependencies": [
        "foundation_values"
      ]
    },
    "accounts": {
      "directory": "packages/accounts",
      "publicEntrypoints": [
        "accounts.dart"
      ],
      "dependencies": [
        "foundation_values"
      ]
    },
    "categories": {
      "directory": "packages/categories",
      "publicEntrypoints": [
        "categories.dart"
      ],
      "dependencies": [
        "foundation_values"
      ]
    },
    "ledger": {
      "directory": "packages/ledger",
      "publicEntrypoints": [
        "ledger.dart"
      ],
      "dependencies": [
        "foundation_values"
      ]
    },
    "reports": {
      "directory": "packages/reports",
      "publicEntrypoints": [
        "reports.dart"
      ],
      "dependencies": [
        "foundation_values",
        "ledger"
      ]
    },
    "budgets": {
      "directory": "packages/budgets",
      "publicEntrypoints": ["budgets.dart"],
      "dependencies": ["categories", "foundation_values", "reports"]
    },
    "credit_cards": {
      "directory": "packages/credit_cards",
      "publicEntrypoints": ["credit_cards.dart"],
      "dependencies": ["foundation_values"]
    },
    "investments": {
      "directory": "packages/investments",
      "publicEntrypoints": ["investments.dart"],
      "dependencies": ["foundation_values"]
    },
    "market_data": {
      "directory": "packages/market_data",
      "publicEntrypoints": ["market_data.dart"],
      "dependencies": ["foundation_values", "investments"]
    },
    "recurring_transactions": {
      "directory": "packages/recurring_transactions",
      "publicEntrypoints": ["recurring_transactions.dart"],
      "dependencies": ["foundation_values"]
    },
    "data_exchange": {
      "directory": "packages/data_exchange",
      "publicEntrypoints": [
        "data_exchange.dart"
      ],
      "dependencies": [
        "accounts",
        "foundation_values",
        "ledger"
      ]
    },
    "tags": {
      "directory": "packages/tags",
      "publicEntrypoints": [
        "tags.dart"
      ],
      "dependencies": [
        "foundation_values"
      ]
    },
    "merchants": {
      "directory": "packages/merchants",
      "publicEntrypoints": [
        "merchants.dart"
      ],
      "dependencies": [
        "foundation_values"
      ]
    },
    "entry_drafts": {
      "directory": "packages/entry_drafts",
      "publicEntrypoints": [
        "entry_drafts.dart"
      ],
      "dependencies": [
        "foundation_values",
        "ledger"
      ]
    },
    "amount_input": {
      "directory": "packages/amount_input",
      "publicEntrypoints": [
        "amount_input.dart"
      ],
      "dependencies": [
        "foundation_values"
      ]
    }
  },
  "runtimeModules": {
    "ledger_vault": {
      "directory": "infrastructure/ledger_vault",
      "publicEntrypoints": ["ledger_vault.dart"],
      "dependencies": ["backup_security", "foundation_values", "ledger_sqlcipher", "storage_sqlcipher"]
    },
    "backup_service": {
      "directory": "infrastructure/backup_service",
      "publicEntrypoints": ["backup_service.dart"],
      "dependencies": ["backup_security", "drive_backup", "foundation_values", "ledger_backup", "ledger_sqlcipher"]
    },
    "drive_backup": {
      "directory": "infrastructure/drive_backup",
      "publicEntrypoints": ["drive_backup.dart", "testing.dart"],
      "dependencies": ["storage_sqlcipher"]
    },
    "ledger_backup": {
      "directory": "infrastructure/ledger_backup",
      "publicEntrypoints": ["ledger_backup.dart"],
      "dependencies": ["app_core", "backup_security", "foundation_values", "ledger_sqlcipher", "storage_sqlcipher"]
    },
    "expense_tracker": {
      "directory": "apps/expense_tracker",
      "dependencies": ["accounts", "app_core", "bookkeeping", "foundation_values", "ledger"]
    },
    "market_adapters": {
      "directory": "infrastructure/market_adapters",
      "publicEntrypoints": ["market_adapters.dart"],
      "dependencies": ["market_data"]
    },
    "ledger_sqlcipher": {
      "directory": "infrastructure/ledger_sqlcipher",
      "publicEntrypoints": ["ledger_sqlcipher.dart"],
      "dependencies": ["accounts", "app_core", "bookkeeping", "budgets", "categories", "credit_cards", "foundation_values", "investments", "ledger", "merchants", "recurring_transactions", "reports", "storage_sqlcipher", "tags"]
    },
    "backup_security": {
      "directory": "infrastructure/backup_security",
      "publicEntrypoints": ["backup_security.dart"],
      "dependencies": []
    },
    "storage_sqlcipher": {
      "directory": "infrastructure/storage_sqlcipher",
      "publicEntrypoints": ["storage_sqlcipher.dart"],
      "dependencies": ["app_core", "foundation_values"]
    },
    "cloud_backup_probe": {
      "directory": "prototypes/cloud_backup",
      "publicEntrypoints": ["cloud_backup.dart", "cloud_backup_history.dart", "cloud_backup_manual_flow.dart", "cloud_backup_schedule.dart", "google_drive_adapter.dart", "google_drive_http.dart", "cloud_backup_work.dart"],
      "dependencies": ["backup_envelope_probe", "encrypted_storage_probe", "persistent_jobs_probe"]
    },
    "persistent_jobs_probe": {
      "directory": "prototypes/persistent_jobs",
      "publicEntrypoints": ["persistent_jobs.dart"],
      "dependencies": ["encrypted_storage_probe"]
    },
    "expense_preview": {
      "directory": "prototypes/expense_preview",
        "dependencies": ["amount_input", "entry_drafts", "data_exchange", "tags", "merchants", "accounts", "categories", "budgets", "recurring_transactions", "credit_cards", "investments", "market_adapters", "market_data", "foundation_values", "ledger", "reports", "android_foundation", "ledger_generation_probe", "storage_generation_probe", "backup_envelope_probe", "cloud_backup_probe", "validated_restore_probe", "encrypted_storage_probe", "persistent_jobs_probe"]
    },
    "android_foundation": {
      "directory": "prototypes/android_foundation",
      "dependencies": ["accounts", "foundation_values", "ledger", "modular_persistence_probe", "encrypted_storage_probe", "validated_restore_probe", "ledger_generation_probe", "storage_generation_probe"]
    },
    "ledger_generation_probe": {
      "directory": "prototypes/ledger_generation",
      "dependencies": ["budgets", "recurring_transactions", "credit_cards", "investments", "tags", "merchants", "categories", "data_exchange", "accounts", "foundation_values", "ledger", "reports", "modular_persistence_probe", "backup_envelope_probe", "validated_restore_probe", "encrypted_storage_probe", "storage_generation_probe"]
    },
    "storage_generation_probe": {
      "directory": "prototypes/storage_generation",
      "dependencies": ["foundation_values", "encrypted_storage_probe"]
    },
    "validated_restore_probe": {
      "directory": "prototypes/validated_restore",
      "dependencies": ["backup_envelope_probe", "modular_persistence_probe", "foundation_values", "ledger"]
    },
    "modular_persistence_probe": {
      "directory": "prototypes/modular_persistence",
      "dependencies": ["budgets", "recurring_transactions", "credit_cards", "investments", "tags", "merchants", "categories", "accounts", "foundation_values", "ledger"]
    },
    "encrypted_storage_probe": {
      "directory": "prototypes/encrypted_storage",
      "dependencies": ["accounts", "foundation_values", "ledger", "modular_persistence_probe", "validated_restore_probe", "backup_envelope_probe"]
    },
    "backup_envelope_probe": {
      "directory": "prototypes/backup_envelope",
      "dependencies": []
    }
  }
}
